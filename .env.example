# HexShield configuration (environment variables).
# The CLI also accepts these as flags. Env vars keep secrets out of files.

# --- Local LLM (Ollama) ---
# Model to use locally. Picks a strong small agentic model by default.
# Swap freely: robit/ornith:9b, llama3.1:8b, mistral:7b, qwen2.5:7b, phi3:mini, etc.
HEXSHIELD_OLLAMA_MODEL=robit/ornith:9b
HEXSHIELD_OLLAMA_HOST=http://127.0.0.1:11434

# --- API fallback (used if Ollama is unreachable) ---
# Set your key to enable. Works with any OpenAI-compatible endpoint:
#   OpenAI      base=https://api.openai.com/v1    model=gpt-4o-mini
#   Groq        base=https://api.groq.com/openai/v1 model=llama-3.3-70b-versatile
#   DeepSeek    base=https://api.deepseek.com/v1   model=deepseek-chat
#   Local vLLM  base=http://localhost:8000/v1
HEXSHIELD_API_KEY=
HEXSHIELD_API_MODEL=
HEXSHIELD_API_BASE=https://api.openai.com/v1
